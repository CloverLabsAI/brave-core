+// Get WebRTC IP overrides from BraveSessionCache
+void GetWebRTCIPOverrides(ExecutionContext* context,
+                          String* out_ipv4,
+                          String* out_ipv6) {
+  // Default values
+  *out_ipv4 = "0.0.0.0";
+  *out_ipv6 = "::";
+
+  if (!context) {
+    return;
+  }
+
+  // Get overrides from session cache (already populated from browser process)
+  auto& session_cache = brave::BraveSessionCache::From(*context);
+  if (session_cache.HasWebRTCIPOverride()) {
+    *out_ipv4 = session_cache.GetWebRTCIPv4Override();
+    *out_ipv6 = session_cache.GetWebRTCIPv6Override();
+  }
+}
+
+// Mask IP addresses in SDP to prevent WebRTC IP leaks
+String MaskSdpIpAddresses(const String& original_sdp, ExecutionContext* context) {
+  if (original_sdp.IsNull() || original_sdp.empty()) {
+    return original_sdp;
+  }
+
+  // Get per-BrowserContext IP overrides from browser process
+  String mask_ipv4;
+  String mask_ipv6;
+  GetWebRTCIPOverrides(context, &mask_ipv4, &mask_ipv6);
+
+  // Mask ALL IPs except mDNS (.local) addresses on a per-line basis
+  String result = original_sdp;
+  wtf_size_t pos = 0;
+
+  // Mask connection lines: c=IN IP4/IP6 <anything> -> c=IN IP4 <mask_ipv4>
+  pos = 0;
+  while ((pos = result.find("c=IN ", pos)) != kNotFound) {
+    wtf_size_t line_end = result.find("\n", pos);
+    if (line_end == kNotFound) line_end = result.length();
+
+    String before = result.Substring(0, pos);
+    String after = result.Substring(line_end);
+    result = before + "c=IN IP4 " + mask_ipv4 + after;
+
+    pos = pos + 9 + mask_ipv4.length();  // Length of "c=IN IP4 " + mask
+  }
+
+  // Mask origin lines: o=... IN IP4/IP6 <anything> -> o=... IN IP4 <mask_ipv4>
+  pos = 0;
+  while ((pos = result.find("o=", pos)) != kNotFound) {
+    wtf_size_t line_end = result.find("\n", pos);
+    if (line_end == kNotFound) line_end = result.length();
+
+    String origin_line = result.Substring(pos, line_end - pos);
+
+    // Check if line contains IN IP4 or IN IP6
+    if (origin_line.contains(" IN IP4 ") || origin_line.contains(" IN IP6 ")) {
+      // Find where " IN IP" starts
+      wtf_size_t in_ip_pos = origin_line.find(" IN IP");
+      if (in_ip_pos != kNotFound) {
+        // Replace from " IN IP" onwards with " IN IP4 <mask_ipv4>"
+        String origin_prefix = origin_line.Substring(0, in_ip_pos);
+        String before = result.Substring(0, pos);
+        String after = result.Substring(line_end);
+        result = before + origin_prefix + " IN IP4 " + mask_ipv4 + after;
+
+        pos = pos + origin_prefix.length() + 9 + mask_ipv4.length();
+      } else {
+        pos = line_end;
+      }
+    } else {
+      pos = line_end;
+    }
+  }
+
+  // Mask IP addresses in candidate lines
+  // Format: a=candidate:... udp ... <IP> <port> typ ... [raddr <IP>] [rport <port>]
+  pos = 0;
+  while ((pos = result.find("a=candidate:", pos)) != kNotFound) {
+    wtf_size_t line_end = result.find("\n", pos);
+    if (line_end == kNotFound) line_end = result.length();
+
+    String candidate_line = result.Substring(pos, line_end - pos);
+    Vector<String> parts;
+    parts = candidate_line.Split(' ');
+
+    // The IP address is at index 4 in the candidate line
+    // a=candidate:<foundation> <component> <protocol> <priority> <IP> <port> ...
+    bool modified = false;
+    if (parts.size() >= 6) {
+      String original_ip = parts[4];
+      // Don't mask if already mDNS (.local)
+      if (!original_ip.ends_with(".local")) {
+        // Determine if IPv4 or IPv6 and use custom mask
+        if (original_ip.contains(":")) {
+          parts[4] = mask_ipv6;  // IPv6
+        } else {
+          parts[4] = mask_ipv4;  // IPv4
+        }
+        modified = true;
+      }
+    }
+
+    // Also mask raddr (related address) if present
+    // Format: ... raddr <IP> rport <port> ...
+    for (wtf_size_t i = 0; i < parts.size(); i++) {
+      if (parts[i] == "raddr" && i + 1 < parts.size()) {
+        String raddr_ip = parts[i + 1];
+        if (!raddr_ip.ends_with(".local")) {
+          if (raddr_ip.contains(":")) {
+            parts[i + 1] = mask_ipv6;  // IPv6
+          } else {
+            parts[i + 1] = mask_ipv4;  // IPv4
+          }
+          modified = true;
+        }
+      }
+    }
+
+    // Reconstruct the candidate line if any modifications were made
+    if (modified) {
+      StringBuilder masked_line;
+      for (wtf_size_t i = 0; i < parts.size(); i++) {
+        if (i > 0) masked_line.Append(' ');
+        masked_line.Append(parts[i]);
+      }
+
+      String before = result.Substring(0, pos);
+      String after = result.Substring(line_end);
+      result = before + masked_line.ToString() + after;
+
+      // Update line_end to reflect the new string length
+      line_end = pos + masked_line.ToString().length();
+    }
+
+    pos = line_end;
+  }
+
+  return result;
+}
