 String RTCSessionDescription::sdp() const {
-  return platform_session_description_->Sdp();
+  String original_sdp = platform_session_description_->Sdp();
+
+  if (original_sdp.IsNull() || original_sdp.empty()) {
+    return original_sdp;
+  }
+
+  // Mask IP addresses in SDP lines to prevent WebRTC leaks
+  // Note: We mask ALL IPs except mDNS (.local) addresses on a per-line basis
+  String result = original_sdp;
+  wtf_size_t pos = 0;
+
+  // Mask origin lines: o=- <sess-id> <sess-version> IN IP4 <IP>
+  pos = 0;
+  while ((pos = result.Find(" IN IP4 ", pos)) != kNotFound) {
+    // Check if this is part of an origin line (o=) or connection line (c=)
+    wtf_size_t line_start = result.ReverseFind("\n", pos);
+    if (line_start == kNotFound) line_start = 0;
+    else line_start += 1;  // Move past the newline
+
+    String line_prefix = result.Substring(line_start, pos - line_start);
+    if (line_prefix.StartsWith("o=") || line_prefix.StartsWith("c=")) {
+      wtf_size_t ip_start = pos + 8;  // Length of " IN IP4 "
+      wtf_size_t ip_end = result.Find("\n", ip_start);
+      if (ip_end == kNotFound) ip_end = result.Find("\r", ip_start);
+      if (ip_end == kNotFound) ip_end = result.length();
+
+      String before = result.Substring(0, ip_start);
+      String after = result.Substring(ip_end);
+      result = before + "0.0.0.0" + after;
+
+      pos = ip_start + 7;  // Length of "0.0.0.0"
+    } else {
+      pos += 8;
+    }
+  }
+
+  // Mask IPv6 origin and connection lines: IN IP6 <IP>
+  pos = 0;
+  while ((pos = result.Find(" IN IP6 ", pos)) != kNotFound) {
+    wtf_size_t line_start = result.ReverseFind("\n", pos);
+    if (line_start == kNotFound) line_start = 0;
+    else line_start += 1;
+
+    String line_prefix = result.Substring(line_start, pos - line_start);
+    if (line_prefix.StartsWith("o=") || line_prefix.StartsWith("c=")) {
+      wtf_size_t ip_start = pos + 8;  // Length of " IN IP6 "
+      wtf_size_t ip_end = result.Find("\n", ip_start);
+      if (ip_end == kNotFound) ip_end = result.Find("\r", ip_start);
+      if (ip_end == kNotFound) ip_end = result.length();
+
+      String before = result.Substring(0, ip_start);
+      String after = result.Substring(ip_end);
+      result = before + "::" + after;
+
+      pos = ip_start + 2;  // Length of "::"
+    } else {
+      pos += 8;
+    }
+  }
+
+  // Mask IP addresses in candidate lines
+  // Format: a=candidate:... udp ... <IP> <port> typ ... [raddr <IP>] [rport <port>]
+  pos = 0;
+  while ((pos = result.Find("a=candidate:", pos)) != kNotFound) {
+    wtf_size_t line_end = result.Find("\n", pos);
+    if (line_end == kNotFound) line_end = result.Find("\r", pos);
+    if (line_end == kNotFound) line_end = result.length();
+
+    String candidate_line = result.Substring(pos, line_end - pos);
+    Vector<String> parts;
+    candidate_line.Split(' ', parts);
+
+    // The IP address is at index 4 in the candidate line
+    // a=candidate:<foundation> <component> <protocol> <priority> <IP> <port> ...
+    bool modified = false;
+    if (parts.size() >= 6) {
+      String original_ip = parts[4];
+      // Don't mask if already mDNS (.local)
+      if (!original_ip.EndsWith(".local")) {
+        // Determine if IPv4 or IPv6
+        if (original_ip.Contains(":")) {
+          parts[4] = "::";  // IPv6
+        } else {
+          parts[4] = "0.0.0.0";  // IPv4
+        }
+        modified = true;
+      }
+    }
+
+    // Also mask raddr (related address) if present
+    // Format: ... raddr <IP> rport <port> ...
+    for (wtf_size_t i = 0; i < parts.size(); i++) {
+      if (parts[i] == "raddr" && i + 1 < parts.size()) {
+        String raddr_ip = parts[i + 1];
+        if (!raddr_ip.EndsWith(".local")) {
+          if (raddr_ip.Contains(":")) {
+            parts[i + 1] = "::";  // IPv6
+          } else {
+            parts[i + 1] = "0.0.0.0";  // IPv4
+          }
+          modified = true;
+        }
+      }
+    }
+
+    // Reconstruct the candidate line if any modifications were made
+    if (modified) {
+      StringBuilder masked_line;
+      for (wtf_size_t i = 0; i < parts.size(); i++) {
+        if (i > 0) masked_line.Append(' ');
+        masked_line.Append(parts[i]);
+      }
+
+      String before = result.Substring(0, pos);
+      String after = result.Substring(line_end);
+      result = before + masked_line.ToString() + after;
+
+      // Update line_end to reflect the new string length
+      line_end = pos + masked_line.ToString().length();
+    }
+
+    pos = line_end;
+  }
+
+  return result;
 }
 
