+    parts[4] = "0.0.0.0";
+
+    // Reconstruct the candidate string with masked IP
+    StringBuilder result;
+    for (wtf_size_t i = 0; i < parts.size(); i++) {
+      if (i > 0) result.Append(' ');
+      result.Append(parts[i]);
+    }
+    return result.ToString();
+  }
+
+  return original;
