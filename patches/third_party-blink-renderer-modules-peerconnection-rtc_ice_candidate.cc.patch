 String RTCIceCandidate::candidate() const {
-  return platform_candidate_->Candidate();
+  String original = platform_candidate_->Candidate();
+  if (original.IsNull() || original.empty()) {
+    return original;
+  }
+
+  // Get per-BrowserContext IP overrides from browser process
+  String mask_ipv4;
+  String mask_ipv6;
+  GetWebRTCIPOverrides(execution_context_, &mask_ipv4, &mask_ipv6);
+
+  // Only allow mDNS candidates (*.local), mask all other IP addresses
+  if (original.Contains(".local")) {
+    return original;  // Already mDNS obfuscated
+  }
+
+  // Replace IP address in SDP string
+  // Format: candidate:<foundation> <component-id> <transport> <priority> <address> <port> typ <type>
+  Vector<String> parts;
+  original.Split(' ', parts);
+
+  if (parts.size() >= 5) {
+    String original_ip = parts[4];
+    if (!original_ip.EndsWith(".local")) {
+      // Use appropriate mask based on IP type
+      parts[4] = original_ip.Contains(":") ? mask_ipv6 : mask_ipv4;
+
+      // Reconstruct the candidate string
+      StringBuilder result;
+      for (wtf_size_t i = 0; i < parts.size(); i++) {
+        if (i > 0) {
+          result.Append(' ');
+        }
+        result.Append(parts[i]);
+      }
+      return result.ToString();
+    }
+  }
+
+  return original;
 }
 
