 String RTCIceCandidate::candidate() const {
-  return platform_candidate_->Candidate();
+  String original = platform_candidate_->Candidate();
+  if (original.IsNull() || original.empty()) {
+    return original;
+  }
+
+  // Only allow mDNS candidates (*.local), mask all IP addresses
+  // SDP format: candidate:<foundation> <component-id> <transport> <priority> <address> <port> typ <type>
+  if (original.Contains(".local")) {
+    return original;  // Already mDNS obfuscated
+  }
+
+  // Replace IP address in SDP string with 0.0.0.0
+  // Split by spaces to find the IP address field (5th field in SDP)
+  Vector<String> parts;
+  original.Split(' ', parts);
+
+  if (parts.size() >= 5) {
+    // Field 4 (index 4) is the IP address
+    parts[4] = "0.0.0.0";
+
+    // Reconstruct the candidate string
+    StringBuilder result;
+    for (wtf_size_t i = 0; i < parts.size(); i++) {
+      if (i > 0) {
+        result.Append(' ');
+      }
+      result.Append(parts[i]);
+    }
+    return result.ToString();
+  }
+
+  return original;
 }
 
