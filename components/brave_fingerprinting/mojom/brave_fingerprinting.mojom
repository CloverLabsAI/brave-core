module brave.mojom;

// Browser-side interface for managing per-profile fingerprinting overrides
interface BraveFingerprintingHost {
  // Set the master fingerprinting seed for this browser context
  SetMasterSeed(uint64 seed);

  // Set WebRTC IP overrides for this browser context
  SetWebRTCIPv4(string ipv4);
  SetWebRTCIPv6(string ipv6);

  // Get master fingerprinting seed for this browser context
  [Sync]
  GetMasterSeed() => (bool has_seed, uint64 seed);

  // Get WebRTC IP overrides for this browser context
  [Sync]
  GetWebRTCIPOverrides() => (bool has_override, string ipv4, string ipv6);
};
